<Window x:Class="LifeSyncTaskClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LifeSyncTaskClient.Models"
        xmlns:vm="clr-namespace:LifeSyncTaskClient.ViewModels"
        mc:Ignorable="d"
        Title="Life Sync Personal Tracker"
        Height="760"
        MinHeight="640"
        Width="1220"
        MinWidth="980"
        Icon="Assets/AppIcon.ico"
        Background="#F6F7F9"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18202A" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="Width" Value="145" />
            <EventSetter Event="Loaded" Handler="DatePicker_Loaded" />
            <EventSetter Event="PreviewKeyDown" Handler="DatePicker_PreviewKeyDown" />
            <EventSetter Event="PreviewTextInput" Handler="DatePicker_PreviewTextInput" />
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="Width" Value="150" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#2457A6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PngIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate" Value="{x:Null}" />
        </Style>

        <Style x:Key="SegmentedListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#546171" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Segment"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#18202A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarDayLeftStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F7A46" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#A05A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Normal">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="#FDECEC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#FFF6D8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#EAF7EF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFF" />
                    <Setter Property="Foreground" Value="#18202A" />
                    <Setter Property="BorderBrush" Value="#9CBFEB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskGridTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RemarkPreviewTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TaskGridTextStyle}">
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultiLineRemark}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Remark}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesPreviewTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultiLineNotes}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Notes}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TaskSummaryItemTemplate">
            <Border Margin="0,0,0,8"
                    Background="{Binding SeverityBackground}"
                    BorderBrush="{Binding SeverityBorder}"
                    BorderThickness="1"
                    MinHeight="62"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding SeverityBrush}" />

                    <Grid Grid.Column="1" Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Task}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Border Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Padding="6,2">
                                <TextBlock Text="{Binding CategoryBadge}"
                                           FontSize="11"
                                           Foreground="#27313D"
                                           MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Padding="6,2"
                                    Margin="4,0,0,0">
                                <TextBlock Text="{Binding TypeBadge}"
                                           FontSize="11"
                                           Foreground="#27313D"
                                           MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Background="{Binding DayStateBrush}"
                                Padding="8,3"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding DayState}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding DateLine}"
                                       Foreground="#546171"
                                       FontSize="12"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding RemarkPreview}"
                                       Visibility="{Binding RemarkVisibility}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"
                                       Margin="18,0,0,0"
                                       Foreground="#27313D"
                                       ToolTip="{Binding TaskItem.Remark}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <Border Background="#EAF7EF"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding AlertVisibility}">
                                    <TextBlock Text="Alert" FontSize="11" FontWeight="SemiBold" Foreground="#1F7A46" />
                                </Border>
                                <Border Background="#EAF2FF"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding GoogleTaskVisibility}">
                                    <TextBlock Text="{Binding GoogleTask}" FontSize="11" Foreground="#2457A6" />
                                </Border>
                                <Border Background="#FDECEC"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding SnoozeVisibility}">
                                    <TextBlock Text="{Binding Snooze}" FontSize="11" Foreground="#8A3B2D" />
                                </Border>
                                <Border Background="#EEF2F7"
                                        Padding="6,2"
                                        Visibility="{Binding SyncVisibility}">
                                    <TextBlock Text="{Binding Sync}" FontSize="11" Foreground="#27313D" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="Life Sync Personal Tracker" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Margin="0,7,0,0" HorizontalAlignment="Left" Background="#EEF2F7" BorderBrush="#C8CED8" BorderThickness="1" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tasks" Command="{Binding ShowTasksViewCommand}" Padding="14,5">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#546171" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTasksView}" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#18202A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding WatchListDisplay}" Command="{Binding ShowWatchListViewCommand}" Padding="14,5">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#546171" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWatchListView}" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#18202A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding DailySummaryViewDisplay}" Command="{Binding ShowDailySummaryViewCommand}" Padding="14,5">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#546171" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDailySummaryView}" Value="True">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#18202A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Margin="0,5,0,0" Foreground="#546171" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Loading tasks" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsLoadingTasks, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="Marking complete" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsMarkingComplete, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <CheckBox Content="Check-in"
                                  IsChecked="{Binding CheckinCheckboxValue, Mode=OneWay}"
                                  Command="{Binding CheckinCommand}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LastCheckinDisplay}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="#546171" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastCheckinStale}" Value="True">
                                            <Setter Property="Foreground" Value="#8A1F1F" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button ToolTip="Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PngIconButtonStyle}" Margin="0,0,8,0">
                            <Image Source="Assets/Icons/settings.png" Width="20" Height="20" SnapsToDevicePixels="True" />
                        </Button>
                        <Button Content="Conflicts"
                                ToolTip="Review Sync Conflicts"
                                Command="{Binding OpenTaskConflictsCommand}"
                                Margin="0,0,8,0"
                                Background="#8A3B2D" />
                        <Button Content="+" ToolTip="New Task" Command="{Binding NewTaskCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="{Binding TaskSyncDisplay}"
                                ToolTip="Push Pending Changes And Pull Google Sheet"
                                Command="{Binding RequestTasksCommand}"
                                Background="#1F7A46" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14"
                Visibility="{Binding IsTasksView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding CategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="190"
                                      HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Type" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Types}"
                                      SelectedValue="{Binding TypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="190"
                                      HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Search Task" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <TextBox Text="{Binding TaskSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160"
                                     HorizontalAlignment="Left"
                                     ToolTip="Filter by task name" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Status" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Statuses}"
                                      SelectedItem="{Binding StatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="145"
                                      HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Mode" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding SortModes}"
                                     SelectedItem="{Binding SelectedSortMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SegmentedListBoxStyle}"
                                     ItemContainerStyle="{StaticResource SegmentedListBoxItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>

                        <Button Grid.Column="10"
                                ToolTip="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource PngIconButtonStyle}">
                            <Image Source="Assets/Icons/cancel.png" Width="20" Height="20" SnapsToDevicePixels="True" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ClipToBounds="True">
                    <DataGrid x:Name="TasksGrid"
                      ItemsSource="{Binding TasksView}"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      PreviewMouseLeftButtonDown="TasksGrid_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="TasksGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                              Background="White"
                      BorderBrush="#D9DEE7"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="30"
                      RowHeight="28"
                      HorizontalGridLinesBrush="#E5E9F0"
                      CellStyle="{StaticResource TaskGridCellStyle}"
                      RowStyle="{StaticResource TaskRowStyle}"
                      Visibility="{Binding IsTasksView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105" ElementStyle="{StaticResource TaskGridTextStyle}" CanUserSort="False" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" ElementStyle="{StaticResource TaskGridTextStyle}" CanUserSort="False" />
                            <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="220" ElementStyle="{StaticResource TaskGridTextStyle}" CanUserSort="False" />
                            <DataGridTemplateColumn Header="Expired Date" Width="175" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ExpiredDateDisplay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ExpiredDayDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#546171" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Warning Date" Binding="{Binding WarningDateDisplay}" Width="115" ElementStyle="{StaticResource TaskGridTextStyle}" CanUserSort="False" />
                            <DataGridTemplateColumn Header="Alert Date" Width="175" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AlertDateDisplay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding AlertDayDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#546171" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Last Executed Date" Width="185" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding LastExecutedDateDisplay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding LastExecutedDayDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#546171" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Remark" Binding="{Binding RemarkPreview}" Width="*" MinWidth="180" ElementStyle="{StaticResource RemarkPreviewTextStyle}" CanUserSort="False" />
                            <DataGridTemplateColumn Header="State" Width="92" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#AEB7C3" />
                                                        <Setter Property="ToolTip" Value="Alert disabled" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Alert}" Value="True">
                                                                <Setter Property="Foreground" Value="#1F7A46" />
                                                                <Setter Property="ToolTip" Value="Alert enabled" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" ToolTip="{Binding SyncState}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#1F7A46" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SyncState}" Value="Pending">
                                                                <Setter Property="Foreground" Value="#B7791F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SyncState}" Value="Conflict">
                                                                <Setter Property="Foreground" Value="#B42318" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="●" FontSize="14" ToolTip="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#1F7A46" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="#B7791F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                <Setter Property="Foreground" Value="#B42318" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Not Started">
                                                                <Setter Property="Foreground" Value="#65758B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Visibility="{Binding IsWatchListView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Watch List" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Open" Command="{Binding OpenSelectedWatchTaskCommand}" />
                        </Grid>
                        <DataGrid x:Name="WatchListGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding WatchListItems}"
                                  SelectedItem="{Binding SelectedWatchListItem, Mode=TwoWay}"
                                  MouseDoubleClick="WatchListGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderBrush="#D9DEE7"
                                  BorderThickness="1"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="30"
                                  RowHeight="28"
                                  HorizontalGridLinesBrush="#E5E9F0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180" CanUserSort="False" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="180" CanUserSort="False" />
                                <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="*" MinWidth="280" CanUserSort="False" />
                                <DataGridTextColumn Header="Day Left" Binding="{Binding DayLeft}" Width="100" CanUserSort="False" />
                                <DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded, StringFormat={}{0:dd MMM yyyy}}" Width="130" CanUserSort="False" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border VerticalAlignment="Stretch"
                            Background="White"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            Padding="16"
                            Visibility="{Binding IsDailySummaryView, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Daily Summary" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TaskSummaryDisplay}" Margin="0,4,0,0" Foreground="#546171" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{Binding SelectedTaskSummaryDisplay}"
                                           FontWeight="SemiBold"
                                           Foreground="#27313D"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Open" Command="{Binding OpenSelectedTaskSummaryItemCommand}" Margin="0,0,8,0" />
                                    <Button Content="+1 day" ToolTip="Snooze or extend by 1 day" Command="{Binding SnoozeTaskSummary1DayCommand}" Margin="0,0,6,0" />
                                    <Button Content="+3 days" ToolTip="Snooze or extend by 3 days" Command="{Binding SnoozeTaskSummary3DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="+7 days" ToolTip="Snooze or extend by 7 days" Command="{Binding SnoozeTaskSummary7DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="+14 days" ToolTip="Snooze or extend by 14 days" Command="{Binding SnoozeTaskSummary14DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="+30 days" ToolTip="Snooze or extend by 30 days" Command="{Binding SnoozeTaskSummary30DaysCommand}" Margin="0,0,8,0" />
                                    <Button Content="Clear Snooze" Command="{Binding ClearTaskSummarySnoozeCommand}" Background="#65758B" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="Custom" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <DatePicker SelectedDate="{Binding TaskSummaryCustomSnoozeUntil}" Width="145" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding TaskSummarySnoozeNote, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260"
                                             Margin="0,0,8,0"
                                             ToolTip="Snooze note" />
                                    <Button Content="Snooze" Command="{Binding SnoozeTaskSummaryCustomCommand}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer x:Name="TaskSummaryScrollViewer"
                                          Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Expired / Overdue" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="No expired tasks"
                                               Foreground="#65758B"
                                               Margin="0,0,0,16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExpiredTaskSummaryItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding ExpiredTaskSummaryItems}"
                                             SelectedItem="{Binding SelectedExpiredTaskSummaryItem, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource TaskSummaryItemTemplate}"
                                             HorizontalContentAlignment="Stretch"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,0,0,16"
                                             Visibility="{Binding HasExpiredTaskSummaryItems, Converter={StaticResource BoolToVisibilityConverter}}"
                                             PreviewMouseWheel="TaskSummaryList_PreviewMouseWheel"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                                    <TextBlock Text="Warning" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="No warning tasks"
                                               Foreground="#65758B">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarningTaskSummaryItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding WarningTaskSummaryItems}"
                                             SelectedItem="{Binding SelectedWarningTaskSummaryItem, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource TaskSummaryItemTemplate}"
                                             HorizontalContentAlignment="Stretch"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,0,0,16"
                                             Visibility="{Binding HasWarningTaskSummaryItems, Converter={StaticResource BoolToVisibilityConverter}}"
                                             PreviewMouseWheel="TaskSummaryList_PreviewMouseWheel"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                                    <TextBlock Text="Snoozed" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="No snoozed tasks" Foreground="#65758B">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSnoozedTaskSummaryItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding SnoozedTaskSummaryItems}"
                                             SelectedItem="{Binding SelectedSnoozedTaskSummaryItem, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource TaskSummaryItemTemplate}"
                                             HorizontalContentAlignment="Stretch"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Visibility="{Binding HasSnoozedTaskSummaryItems, Converter={StaticResource BoolToVisibilityConverter}}"
                                             PreviewMouseWheel="TaskSummaryList_PreviewMouseWheel"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Width="585"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#C8CED8"
                    BorderThickness="1,0,0,1"
                    Padding="16"
                    Panel.ZIndex="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#526071" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform X="605" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskSidebarOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="605"
                                                             To="0"
                                                             Duration="0:0:0.22" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected Task" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedTaskPath}" Margin="0,4,18,0" Foreground="#27313D" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                        <TextBlock Text="{Binding SelectedTaskDateDisplay}" Foreground="#546171" />
                                        <TextBlock Text="{Binding SelectedTaskDayLeftDisplay}" Margin="6,0,0,0" Style="{StaticResource SidebarDayLeftStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedTaskSnoozeDisplay}" Margin="0,4,18,0" Foreground="#8A3B2D" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedTaskGoogleTaskDisplay}" Margin="0,2,18,0" Foreground="#546171" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        ToolTip="Close Selected Task"
                                        Command="{Binding CloseTaskSidebarCommand}"
                                        Style="{StaticResource PngIconButtonStyle}"
                                        VerticalAlignment="Top">
                                    <Image Source="Assets/Icons/close.png" Width="20" Height="20" SnapsToDevicePixels="True" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Complete Date" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <DatePicker SelectedDate="{Binding CompletionDate}" Width="160" HorizontalAlignment="Left" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                Content="✓"
                                ToolTip="Mark Complete"
                                Command="{Binding MarkCompleteCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Background="#8A3B2D" />

                                <Button Grid.Column="2"
                                        Content="Edit"
                                        Command="{Binding EditTaskCommand}"
                                        Margin="12,22,0,0"
                                        VerticalAlignment="Top"
                                        Background="#65758B" />

                                <Button Grid.Column="3"
                                        Content="Archive"
                                        Command="{Binding ArchiveTaskCommand}"
                                        Margin="8,22,0,0"
                                        VerticalAlignment="Top"
                                        Background="#8A3B2D" />

                                <Button Grid.Column="4"
                                        Content="{Binding WatchListActionDisplay}"
                                        Command="{Binding ToggleSelectedTaskWatchCommand}"
                                        Margin="8,22,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#2F6F9F" />
                            </Grid>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Selected Remark" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding SelectedRemarkDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.RowSpan="3"
                        Background="#66000000"
                        Panel.ZIndex="7"
                        Visibility="{Binding IsTaskEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding TaskEditorTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TaskCategoryOptions}"
                                                  Text="{Binding TaskEditDraft.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Type" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TaskTypeOptions}"
                                                  Text="{Binding TaskEditDraft.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                    <TextBlock Text="Task" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding TaskEditDraft.Task, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="Expired Cycle" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TaskEditDraft.ExpiredValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding TaskCycleUnits}" SelectedItem="{Binding TaskEditDraft.ExpiredUnit}" Width="130" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Warning Cycle" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TaskEditDraft.WarningValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding TaskCycleUnits}" SelectedItem="{Binding TaskEditDraft.WarningUnit}" Width="130" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,0">
                                    <CheckBox Content="Create Google Task alerts" IsChecked="{Binding TaskEditDraft.Alert}" Margin="0,0,24,0" />
                                    <CheckBox Content="Keep Audit history" IsChecked="{Binding TaskEditDraft.History}" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                                           Text="Dates begin after the first completion."
                                           Foreground="#546171"
                                           Margin="0,10,0,0" />
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Save" Command="{Binding SaveTaskCommand}" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding CancelTaskEditCommand}" Background="#65758B" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Border Grid.RowSpan="3"
                        Background="#66000000"
                        Panel.ZIndex="8"
                        Visibility="{Binding IsTaskConflictOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="760"
                            MaxHeight="540"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Task Sync Conflicts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TaskConflicts}"
                                      SelectedItem="{Binding SelectedTaskConflict}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Operation" Binding="{Binding OperationType}" Width="100" />
                                    <DataGridTextColumn Header="PC Task" Binding="{Binding Payload.Task}" Width="*" />
                                    <DataGridTextColumn Header="Sheet Task" Binding="{Binding ServerTask.Task}" Width="*" />
                                    <DataGridTextColumn Header="Sheet Revision" Binding="{Binding ServerTask.Revision}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="Keep PC" Command="{Binding KeepPcTaskConflictCommand}" Margin="0,0,8,0" />
                                <Button Content="Use Sheet" Command="{Binding UseSheetTaskConflictCommand}" Margin="0,0,8,0" Background="#8A3B2D" />
                                <Button Content="Close" Command="{Binding CloseTaskConflictsCommand}" Background="#65758B" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Border Grid.RowSpan="3"
                        Background="#66000000"
                        Panel.ZIndex="5"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                            <TextBlock Grid.Row="1" Text="General" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Apps Script URL" VerticalAlignment="Center" Margin="0,0,12,10" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding GoogleAppsScriptUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10" />

                                <TextBlock Grid.Row="1" Text="API Key" VerticalAlignment="Center" Margin="0,0,12,10" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Width="260"
                                         HorizontalAlignment="Left"
                                         Margin="0,0,0,10" />

                                <TextBlock Grid.Row="2" Text="Log Days" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70"
                                         HorizontalAlignment="Left" />
                            </Grid>

                            <TextBlock Grid.Row="3" Text="Check-in Schedule" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <CheckBox Grid.Row="4"
                                      Content="Check all / uncheck all"
                                      IsThreeState="True"
                                      IsChecked="{Binding AllCheckinDaysEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12" />

                            <ItemsControl Grid.Row="5" ItemsSource="{Binding CheckinSettingsDraft}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Content="{Binding DayName}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="4"
                                                     Width="90"
                                                     HorizontalAlignment="Left" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="✓" ToolTip="Save" Command="{Binding SaveSettingsCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" />
                                <Button ToolTip="Cancel Settings" Command="{Binding CancelSettingsCommand}" Style="{StaticResource PngIconButtonStyle}">
                                    <Image Source="Assets/Icons/cancel.png" Width="20" Height="20" SnapsToDevicePixels="True" />
                                </Button>
