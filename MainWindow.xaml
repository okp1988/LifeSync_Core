                                <DataGridTextColumn Header="Type" Binding="{Binding TrackType}" Width="115" CanUserSort="False" />
                                <DataGridTextColumn Header="Owned" Binding="{Binding TotalQuantity}" Width="80" CanUserSort="False" />
                                <DataGridTextColumn Header="Used" Binding="{Binding UsedQuantity}" Width="70" CanUserSort="False" />
                            <DataGridTextColumn Header="Left" Binding="{Binding LeftQuantity}" Width="70" ElementStyle="{StaticResource TrackLeftCellStyle}" CanUserSort="True" />
                                <DataGridTextColumn Header="Alert Date" Binding="{Binding AlertDate, StringFormat={}{0:dd MMM yyyy}}" Width="110" ElementStyle="{StaticResource TrackExpiryCellStyle}" CanUserSort="False" />
                                <DataGridTextColumn Header="Alert Status" Binding="{Binding AlertStatus}" Width="115" ElementStyle="{StaticResource TrackExpiryCellStyle}" CanUserSort="False" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding NotesPreview}" Width="*" MinWidth="180" ElementStyle="{StaticResource NotesPreviewTextStyle}" CanUserSort="False" />
                                </DataGrid.Columns>
