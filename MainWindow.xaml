                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="90" />
                                    <DataGridTextColumn Header="Needs Attention" Binding="{Binding AlertCount}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <Border Background="#66000000"
                            Panel.ZIndex="6"
                            Visibility="{Binding IsTrackSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="560"
                                MaxHeight="620"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="#C8CED8"
                                BorderThickness="1"
                                Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.26" Color="#526071" />
                            </Border.Effect>
                            <Grid DataContext="{Binding TrackSettingsDraft}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Track Settings" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Highlight thresholds and expiry alert windows" Margin="0,4,0,0" Foreground="#546171" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
