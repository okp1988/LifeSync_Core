                                    <Button Content="3 days" Command="{Binding SnoozeTaskSummary3DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="7 days" Command="{Binding SnoozeTaskSummary7DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="14 days" Command="{Binding SnoozeTaskSummary14DaysCommand}" Margin="0,0,6,0" />
