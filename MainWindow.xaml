                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="View" Margin="0,0,0,5" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding TrackHomeViews}"
                                              SelectedItem="{Binding SelectedTrackHomeView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Category" Margin="0,0,0,5" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding TrackCategories}"
                                              SelectedItem="{Binding TrackCategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Type" Margin="0,0,0,5" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding TrackTypeFilters}"
                                              SelectedItem="{Binding TrackTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="White"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrackItemListView}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
