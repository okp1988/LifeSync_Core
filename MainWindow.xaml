                                      Grid.Row="6"
                                      ItemsSource="{Binding SelectedTrackItem.History}"
                                      IsVisibleChanged="DataGrid_IsVisibleChanged"
                                      SelectedItem="{Binding SelectedTrackHistory, Mode=TwoWay}"
                                      PreviewMouseLeftButtonDown="TrackHistoryGrid_PreviewMouseLeftButtonDown"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      BorderBrush="#D9DEE7"
                                      BorderThickness="1"
                                      RowHeaderWidth="0"
                                      ColumnHeaderHeight="34"
                                      RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Width="105" CanUserSort="False" />
                                    <DataGridTextColumn Header="Event" Binding="{Binding ActionDisplay}" Width="100" CanUserSort="False" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding QuantityDisplay}" Width="70" CanUserSort="False" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockReferenceDisplay}" Width="145" CanUserSort="False" />
                                    <DataGridTextColumn x:Name="TrackHistoryExpiryColumn" Header="Expiry" Binding="{Binding ExpiryDate, StringFormat={}{0:dd MMM yyyy}}" Width="110" CanUserSort="False" />
                                    <DataGridTextColumn Header="Place" Binding="{Binding LocationDisplay}" Width="170" CanUserSort="False" />
                                    <DataGridTextColumn Header="Note" Binding="{Binding NoteDisplay}" Width="*" MinWidth="170" CanUserSort="False" />
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
