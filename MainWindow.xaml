                                  ItemsSource="{Binding TrackItemsView}"
                                  IsVisibleChanged="DataGrid_IsVisibleChanged"
                                  Sorting="TrackItemsGrid_Sorting"
                                  SelectedItem="{Binding SelectedTrackItem, Mode=TwoWay}"
                                  PreviewMouseLeftButtonDown="TrackItemsGrid_PreviewMouseLeftButtonDown"
                                  MouseLeftButtonUp="TrackItemsGrid_MouseLeftButtonUp"
