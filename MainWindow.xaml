                                               Foreground="#65758B"
                                               Margin="0,0,0,16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExpiredTaskSummaryItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding ExpiredTaskSummaryItems}"
                                             SelectedItem="{Binding SelectedExpiredTaskSummaryItem, Mode=TwoWay}"
