<Window x:Class="LifeSyncTaskClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LifeSyncTaskClient.ViewModels"
        mc:Ignorable="d"
        Title="Life Sync Personal Tracker"
        Height="760"
        MinHeight="640"
        Width="1220"
        MinWidth="980"
        Icon="Assets/AppIcon.ico"
        Background="#F6F7F9"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18202A" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="Width" Value="145" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="Width" Value="150" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#2457A6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="StatusCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#7A4A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayLeftCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#7A4A00" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarDayLeftStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F7A46" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#A05A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Normal">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="#FDECEC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#FFF6D8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#EAF7EF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Life Sync Personal Tracker" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" Margin="0,5,0,0" Foreground="#546171" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Loading tasks" Margin="0,0,16,0" Visibility="{Binding IsLoadingTasks, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="Marking complete" Margin="0,0,16,0" Visibility="{Binding IsMarkingComplete, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Request" Command="{Binding RequestTasksCommand}" Width="112" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Apps Script URL" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding GoogleAppsScriptUrl, UpdateSourceTrigger=PropertyChanged}" Width="470" Margin="0,0,18,0" />
                    <TextBlock Text="API Key" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,18,0" />
                    <TextBlock Text="Log Days" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Category" Margin="0,0,0,5" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValue="{Binding CategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Type" Margin="0,0,0,5" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Types}"
                              SelectedValue="{Binding TypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Day Left" Margin="0,0,0,5" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DayLeftFilters}"
                              SelectedItem="{Binding DayLeftFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Status" Margin="0,0,0,5" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding StatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Row="1"
                        Grid.Column="4"
                        Content="Refresh"
                        Command="{Binding RefreshCalculatedFieldsCommand}"
                        Background="#2457A6"
                        VerticalAlignment="Bottom"
                        Width="105"
                        Margin="0,0,10,0" />

                <Button Grid.Row="1"
                        Grid.Column="5"
                        Content="Clear Filters"
                        Command="{Binding ClearFiltersCommand}"
                        Background="#65758B"
                        VerticalAlignment="Bottom"
                        Width="120" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding TasksView}"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F9FAFC"
                      Background="White"
                      BorderBrush="#D9DEE7"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="30"
                      RowHeight="28"
                      HorizontalGridLinesBrush="#E5E9F0"
                      RowStyle="{StaticResource TaskRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                    <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="240" />
                    <DataGridTextColumn Header="Expired Date" Binding="{Binding ExpiredDate, StringFormat={}{0:yyyy-MM-dd}}" Width="115" />
                    <DataGridTextColumn Header="Warning Date" Binding="{Binding WarningDate, StringFormat={}{0:yyyy-MM-dd}}" Width="115" />
                    <DataGridTextColumn Header="Day Left" Binding="{Binding DayLeft}" Width="80" ElementStyle="{StaticResource DayLeftCellStyle}" />
                    <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="*" MinWidth="220" />
                    <DataGridTextColumn Header="Prev Date 1" Binding="{Binding PreviousDate1, StringFormat={}{0:yyyy-MM-dd}}" Width="115" />
                    <DataGridTextColumn Header="Prev Date 2" Binding="{Binding PreviousDate2, StringFormat={}{0:yyyy-MM-dd}}" Width="115" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource StatusCellStyle}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Width="585"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#C8CED8"
                    BorderThickness="1,0,0,1"
                    Padding="16"
                    Panel.ZIndex="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#526071" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform X="605" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTaskSidebarOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="605"
                                                             To="0"
                                                             Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Selected Task" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedTaskPath}" Margin="0,4,18,0" Foreground="#27313D" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                <TextBlock Text="{Binding SelectedTaskDateDisplay}" Foreground="#546171" />
                                <TextBlock Text="{Binding SelectedTaskDayLeftDisplay}" Margin="6,0,0,0" Style="{StaticResource SidebarDayLeftStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="X"
                                Command="{Binding CloseTaskSidebarCommand}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="#65758B"
                                VerticalAlignment="Top" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Complete Date" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DatePicker SelectedDate="{Binding CompletionDate}" Width="160" HorizontalAlignment="Left" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Mark Complete"
                                Command="{Binding MarkCompleteCommand}"
                                Width="145"
                                Height="38"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Background="#8A3B2D" />
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Selected Remark" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SelectedRemarkDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
