<Window x:Class="LifeSyncTaskClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LifeSyncTaskClient.Models"
        xmlns:vm="clr-namespace:LifeSyncTaskClient.ViewModels"
        mc:Ignorable="d"
        Title="Life Sync Personal Tracker"
        Height="760"
        MinHeight="640"
        Width="1220"
        MinWidth="980"
        Icon="Assets/AppIcon.ico"
        Background="#F6F7F9"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Geometry x:Key="SettingsGearGeometry">M10,1.2 L12,1.2 L12.6,3.4 C13.1,3.6 13.6,3.8 14,4.1 L16,3 L17,4.7 L15.5,6.4 C15.7,6.9 15.9,7.4 16,8 L18.2,8.8 L18.2,10.8 L16,11.5 C15.9,12.1 15.7,12.6 15.4,13.1 L16.7,15 L15.1,16.4 L13.2,15.3 C12.7,15.6 12.2,15.8 11.6,15.9 L10.9,18 L8.8,18 L8.2,15.9 C7.6,15.8 7.1,15.6 6.6,15.3 L4.7,16.4 L3.2,14.9 L4.4,13.1 C4.1,12.6 3.9,12.1 3.8,11.5 L1.8,10.8 L1.8,8.8 L3.8,8 C3.9,7.4 4.1,6.9 4.4,6.4 L3,4.7 L4.6,3.1 L6.6,4.1 C7.1,3.8 7.6,3.6 8.2,3.4 Z M10,6.3 A3.7,3.7 0,1 0,10,13.7 A3.7,3.7 0,1 0,10,6.3</Geometry>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18202A" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="Width" Value="145" />
            <EventSetter Event="Loaded" Handler="DatePicker_Loaded" />
            <EventSetter Event="PreviewKeyDown" Handler="DatePicker_PreviewKeyDown" />
            <EventSetter Event="PreviewTextInput" Handler="DatePicker_PreviewTextInput" />
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#C8CED8" />
            <Setter Property="Width" Value="150" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#2457A6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#ECEFF3"
                                BorderBrush="#AEB7C3"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,-1,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#7A4A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayLeftCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#7A4A00" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarDayLeftStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F7A46" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Expired">
                    <Setter Property="Foreground" Value="#8A1F1F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Warning">
                    <Setter Property="Foreground" Value="#A05A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Normal">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedTask.Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1F7A46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="#FDECEC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#FFF6D8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#EAF7EF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="RemarkPreviewTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultiLineRemark}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Remark}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesPreviewTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultiLineNotes}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding Notes}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TaskSummaryItemTemplate">
            <Border Margin="0,0,0,8"
                    Background="{Binding SeverityBackground}"
                    BorderBrush="{Binding SeverityBorder}"
                    BorderThickness="1"
                    MinHeight="78">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding SeverityBrush}" />

                    <Grid Grid.Column="1" Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Task}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="290" />
                            <Border Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Padding="6,2"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding CategoryBadge}" FontSize="11" Foreground="#27313D" />
                            </Border>
                            <Border Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Padding="6,2"
                                    Margin="4,0,0,0">
                                <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="#27313D" />
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="{Binding DayStateBrush}"
                                Padding="8,3"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding DayState}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding DateLine}"
                                   Margin="0,6,0,0"
                                   Foreground="#546171"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding RemarkPreview}"
                                       Visibility="{Binding RemarkVisibility}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="36"
                                       Foreground="#27313D"
                                       ToolTip="{Binding TaskItem.Remark}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Border Background="#EAF2FF"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding GoogleTaskVisibility}">
                                    <TextBlock Text="{Binding GoogleTask}" FontSize="11" Foreground="#2457A6" />
                                </Border>
                                <Border Background="#FDECEC"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding SnoozeVisibility}">
                                    <TextBlock Text="{Binding Snooze}" FontSize="11" Foreground="#8A3B2D" />
                                </Border>
                                <Border Background="#EEF2F7"
                                        Padding="6,2"
                                        Visibility="{Binding SyncVisibility}">
                                    <TextBlock Text="{Binding Sync}" FontSize="11" Foreground="#27313D" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="22">
        <TabItem Header="TASK">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Life Sync Personal Tracker" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Message}" Margin="0,5,0,0" Foreground="#546171" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Loading tasks" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsLoadingTasks, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="Marking complete" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsMarkingComplete, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <CheckBox Content="Check-in"
                                  IsChecked="{Binding CheckinCheckboxValue, Mode=OneWay}"
                                  Command="{Binding CheckinCommand}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LastCheckinDisplay}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="#546171" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastCheckinStale}" Value="True">
                                            <Setter Property="Foreground" Value="#8A1F1F" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button ToolTip="Check-in Settings" Command="{Binding OpenCheckinSettingsCommand}" Style="{StaticResource IconButtonStyle}" ContentTemplate="{x:Null}" Margin="0,0,8,0" Background="#65758B">
                            <Viewbox Width="20" Height="20">
                                <Path Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="{StaticResource SettingsGearGeometry}" />
                            </Viewbox>
                        </Button>
                        <Button Content="{Binding TaskSummaryDisplay}"
                                ToolTip="Daily Summary"
                                Command="{Binding OpenTaskSummaryCommand}"
                                Margin="0,0,8,0"
                                Background="#2F6F9F" />
                        <Button Content="Conflicts"
                                ToolTip="Review Sync Conflicts"
                                Command="{Binding OpenTaskConflictsCommand}"
                                Margin="0,0,8,0"
                                Background="#8A3B2D" />
                        <Button Content="+" ToolTip="New Task" Command="{Binding NewTaskCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="{Binding TaskSyncDisplay}"
                                ToolTip="Push Pending Changes And Pull Google Sheet"
                                Command="{Binding RequestTasksCommand}"
                                Background="#1F7A46" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Apps Script URL" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding GoogleAppsScriptUrl, UpdateSourceTrigger=PropertyChanged}" Width="470" Margin="0,0,18,0" />
                            <TextBlock Text="API Key" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,18,0" />
                            <TextBlock Text="Log Days" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Category" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValue="{Binding CategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Type" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Types}"
                              SelectedValue="{Binding TypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Day Left" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding DayLeftFilters}"
                              SelectedItem="{Binding DayLeftFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Status" Margin="0,0,0,5" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding StatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Grid.Row="1"
                        Grid.Column="4"
                        Content="⨯"
                        ToolTip="Clear Filters"
                        Command="{Binding ClearFiltersCommand}"
                        Background="#65758B"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource IconButtonStyle}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ClipToBounds="True">
                    <DataGrid x:Name="TasksGrid"
                      ItemsSource="{Binding TasksView}"
                      IsVisibleChanged="DataGrid_IsVisibleChanged"
                      Sorting="TasksGrid_Sorting"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      PreviewMouseLeftButtonDown="TasksGrid_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="TasksGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                              Background="White"
                      BorderBrush="#D9DEE7"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="30"
                      RowHeight="28"
                      HorizontalGridLinesBrush="#E5E9F0"
                      RowStyle="{StaticResource TaskRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115" CanUserSort="False" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" CanUserSort="False" />
                            <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="240" CanUserSort="False" />
                            <DataGridTextColumn Header="Sync" Binding="{Binding SyncState}" Width="75" CanUserSort="False" />
                            <DataGridTextColumn Header="Expired Date" Binding="{Binding ExpiredDate, StringFormat={}{0:dd MMM yyyy}}" Width="115" CanUserSort="False" />
                            <DataGridTextColumn Header="Warning Date" Binding="{Binding WarningDate, StringFormat={}{0:dd MMM yyyy}}" Width="115" CanUserSort="False" />
                            <DataGridTextColumn Header="Day Left" Binding="{Binding DayLeft}" Width="80" ElementStyle="{StaticResource DayLeftCellStyle}" CanUserSort="True" />
                            <DataGridTextColumn Header="Day Passed" Binding="{Binding DayPassed}" Width="90" ElementStyle="{StaticResource DayLeftCellStyle}" CanUserSort="False" />
                            <DataGridTextColumn Header="Last Executed Date" Binding="{Binding PreviousDate1, StringFormat={}{0:dd MMM yyyy}}" Width="135" CanUserSort="False" />
                            <DataGridTextColumn Header="Remark" Binding="{Binding RemarkPreview}" Width="*" MinWidth="220" ElementStyle="{StaticResource RemarkPreviewTextStyle}" CanUserSort="False" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" ElementStyle="{StaticResource StatusCellStyle}" CanUserSort="False" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Width="640"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1,0,0,1"
                            Padding="16"
                            Panel.ZIndex="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#526071" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform X="660" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskSummaryOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     From="660"
                                                                     To="0"
                                                                     Duration="0:0:0.22" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Daily Summary" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TaskSummaryDisplay}" Margin="0,4,18,0" Foreground="#546171" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="X"
                                        ToolTip="Close"
                                        Command="{Binding CloseTaskSummaryCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        Background="#65758B"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{Binding SelectedTaskSummaryDisplay}"
                                           FontWeight="SemiBold"
                                           Foreground="#27313D"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Open" Command="{Binding OpenSelectedTaskSummaryItemCommand}" Margin="0,0,8,0" />
                                    <Button Content="1 day" Command="{Binding SnoozeTaskSummary1DayCommand}" Margin="0,0,6,0" />
                                    <Button Content="3 days" Command="{Binding SnoozeTaskSummary3DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="7 days" Command="{Binding SnoozeTaskSummary7DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="14 days" Command="{Binding SnoozeTaskSummary14DaysCommand}" Margin="0,0,6,0" />
                                    <Button Content="30 days" Command="{Binding SnoozeTaskSummary30DaysCommand}" Margin="0,0,8,0" />
                                    <Button Content="Clear Snooze" Command="{Binding ClearTaskSummarySnoozeCommand}" Background="#65758B" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="Custom" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <DatePicker SelectedDate="{Binding TaskSummaryCustomSnoozeUntil}" Width="145" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding TaskSummarySnoozeNote, UpdateSourceTrigger=PropertyChanged}"
                                             Width="260"
                                             Margin="0,0,8,0"
                                             ToolTip="Snooze note" />
                                    <Button Content="Snooze" Command="{Binding SnoozeTaskSummaryCustomCommand}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer x:Name="TaskSummaryScrollViewer"
                                          Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Expired / Overdue" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="No expired tasks"
                                               Foreground="#65758B"
                                               Margin="0,0,0,16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExpiredTaskSummaryItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding ExpiredTaskSummaryItems}"
                                             SelectedItem="{Binding SelectedExpiredTaskSummaryItem, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource TaskSummaryItemTemplate}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,0,0,16"
                                             Visibility="{Binding HasExpiredTaskSummaryItems, Converter={StaticResource BoolToVisibilityConverter}}"
                                             PreviewMouseWheel="TaskSummaryList_PreviewMouseWheel"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                                    <TextBlock Text="Warning" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="No warning tasks"
                                               Foreground="#65758B">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarningTaskSummaryItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ListBox ItemsSource="{Binding WarningTaskSummaryItems}"
                                             SelectedItem="{Binding SelectedWarningTaskSummaryItem, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource TaskSummaryItemTemplate}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Visibility="{Binding HasWarningTaskSummaryItems, Converter={StaticResource BoolToVisibilityConverter}}"
                                             PreviewMouseWheel="TaskSummaryList_PreviewMouseWheel"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Width="585"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#C8CED8"
                    BorderThickness="1,0,0,1"
                    Padding="16"
                    Panel.ZIndex="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#526071" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform X="605" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskSidebarOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="605"
                                                             To="0"
                                                             Duration="0:0:0.22" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected Task" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedTaskPath}" Margin="0,4,18,0" Foreground="#27313D" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                        <TextBlock Text="{Binding SelectedTaskDateDisplay}" Foreground="#546171" />
                                        <TextBlock Text="{Binding SelectedTaskDayLeftDisplay}" Margin="6,0,0,0" Style="{StaticResource SidebarDayLeftStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedTaskSnoozeDisplay}" Margin="0,4,18,0" Foreground="#8A3B2D" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedTaskGoogleTaskDisplay}" Margin="0,2,18,0" Foreground="#546171" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                Content="X"
                                ToolTip="Close"
                                Command="{Binding CloseTaskSidebarCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Background="#65758B"
                                VerticalAlignment="Top" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Complete Date" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <DatePicker SelectedDate="{Binding CompletionDate}" Width="160" HorizontalAlignment="Left" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                Content="✓"
                                ToolTip="Mark Complete"
                                Command="{Binding MarkCompleteCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Background="#8A3B2D" />

                                <Button Grid.Column="2"
                                        Content="Edit"
                                        Command="{Binding EditTaskCommand}"
                                        Margin="12,22,0,0"
                                        VerticalAlignment="Top"
                                        Background="#65758B" />

                                <Button Grid.Column="3"
                                        Content="Archive"
                                        Command="{Binding ArchiveTaskCommand}"
                                        Margin="8,22,0,0"
                                        VerticalAlignment="Top"
                                        Background="#8A3B2D" />
                            </Grid>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Selected Remark" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding SelectedRemarkDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.RowSpan="3"
                        Background="#66000000"
                        Panel.ZIndex="7"
                        Visibility="{Binding IsTaskEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding TaskEditorTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding TaskEditDraft.Category, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Type" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding TaskEditDraft.Type, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                    <TextBlock Text="Task" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding TaskEditDraft.Task, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="Expired Cycle" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TaskEditDraft.ExpiredValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding TaskCycleUnits}" SelectedItem="{Binding TaskEditDraft.ExpiredUnit}" Width="130" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Warning Cycle" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TaskEditDraft.WarningValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding TaskCycleUnits}" SelectedItem="{Binding TaskEditDraft.WarningUnit}" Width="130" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,0">
                                    <CheckBox Content="Create Google Task alerts" IsChecked="{Binding TaskEditDraft.Alert}" Margin="0,0,24,0" />
                                    <CheckBox Content="Keep Audit history" IsChecked="{Binding TaskEditDraft.History}" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                                           Text="Dates begin after the first completion."
                                           Foreground="#546171"
                                           Margin="0,10,0,0" />
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="Save" Command="{Binding SaveTaskCommand}" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding CancelTaskEditCommand}" Background="#65758B" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Border Grid.RowSpan="3"
                        Background="#66000000"
                        Panel.ZIndex="8"
                        Visibility="{Binding IsTaskConflictOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="760"
                            MaxHeight="540"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Task Sync Conflicts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TaskConflicts}"
                                      SelectedItem="{Binding SelectedTaskConflict}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Operation" Binding="{Binding OperationType}" Width="100" />
                                    <DataGridTextColumn Header="PC Task" Binding="{Binding Payload.Task}" Width="*" />
                                    <DataGridTextColumn Header="Sheet Task" Binding="{Binding ServerTask.Task}" Width="*" />
                                    <DataGridTextColumn Header="Sheet Revision" Binding="{Binding ServerTask.Revision}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="Keep PC" Command="{Binding KeepPcTaskConflictCommand}" Margin="0,0,8,0" />
                                <Button Content="Use Sheet" Command="{Binding UseSheetTaskConflictCommand}" Margin="0,0,8,0" Background="#8A3B2D" />
                                <Button Content="Close" Command="{Binding CloseTaskConflictsCommand}" Background="#65758B" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Border Grid.RowSpan="3"
                        Background="#66000000"
                        Panel.ZIndex="5"
                        Visibility="{Binding IsCheckinSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#C8CED8"
                            BorderThickness="1"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Check-in Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                            <CheckBox Grid.Row="1"
                                      Content="Check all / uncheck all"
                                      IsThreeState="True"
                                      IsChecked="{Binding AllCheckinDaysEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12" />

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CheckinSettingsDraft}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Content="{Binding DayName}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="4"
                                                     Width="90"
                                                     HorizontalAlignment="Left" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="✓" ToolTip="Save" Command="{Binding SaveCheckinSettingsCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="X" ToolTip="Cancel" Command="{Binding CancelCheckinSettingsCommand}" Style="{StaticResource IconButtonStyle}" Background="#65758B" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
